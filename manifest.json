{
  "manifest_version": 3,
  "name": "Absolute Note",
  "version": "1.0.0",
  "description": "Notas adhesivas persistentes en cualquier página web.",
  "permissions": ["storage", "contextMenus"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Absolute Note"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["locales.js", "sanitize.js", "content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}
