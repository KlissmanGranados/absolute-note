{
  "manifest_version": 3,
  "name": "Absolute Note",
  "description": "Notas adhesivas persistentes en cualquier página web.",
  "permissions": ["storage"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Absolute Note"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "all_frames": true,
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}
